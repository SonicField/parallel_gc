#!/bin/bash
set -e
SRCDIR=/data/users/alexturner/parallel_gc/cpython-asan
LOG="$SRCDIR/build_asan.log"
cd "$SRCDIR"

exec > "$LOG" 2>&1

echo "=== ASAN Build Script ==="
echo "Date: $(date)"
echo "Commit: $(git log --oneline -1)"
echo ""

echo "=== Step 1: Configure with clang ==="
CC=clang CXX=clang++ ./configure --with-parallel-gc --with-pydebug
echo ""

echo "=== Step 2: Fix pyconfig.h (known configure bug) ==="
sed -i 's|/\* #undef Py_PARALLEL_GC \*/|#define Py_PARALLEL_GC 1|' pyconfig.h
grep "Py_PARALLEL_GC" pyconfig.h
echo ""

echo "=== Step 3: Inject ASAN into Makefile ==="
sed -i 's/^BASECFLAGS=\t/BASECFLAGS=\t -fsanitize=address/' Makefile
sed -i 's/^CONFIGURE_LDFLAGS=.*/CONFIGURE_LDFLAGS=\t-fsanitize=address/' Makefile
echo "CFLAGS check:"
grep "BASECFLAGS" Makefile | head -1
echo "LDFLAGS check:"
grep "CONFIGURE_LDFLAGS=" Makefile | head -1
echo ""

echo "=== Step 4: Build (leak detection disabled for build tools) ==="
# _freeze_module and other build tools leak memory intentionally;
# disable leak detection during build, enable for tests
ASAN_OPTIONS=detect_leaks=0 make -j$(nproc)
echo ""

echo "=== Step 5: Verify binary ==="
ASAN_OPTIONS=detect_leaks=0 ./python --version
ASAN_OPTIONS=detect_leaks=0 ./python -c "import gc; print('parallel config:', gc.get_parallel_config())"
echo ""

echo "=== BUILD COMPLETE ==="
